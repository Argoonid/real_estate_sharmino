# Server-side only. Copy to .env for local Supabase CLI use; never use VITE_ prefixes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
DATABASE_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
# Telegram bot ID is encoded in TELEGRAM_BOT_TOKEN and does not need a separate setting.
TELEGRAM_CHAT_ID=replace-with-primary-chat-id
# Optional comma-separated additional private/group chat IDs.
TELEGRAM_ADMIN_CHAT_IDS=
PUBLIC_SITE_URL=https://your-public-site.example
